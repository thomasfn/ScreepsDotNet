<Project>

	<!-- Various sdk paths -->
	<PropertyGroup>
		<_hostOS>linux</_hostOS>
		<_hostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_hostOS>
		<_hostOS Condition="$([MSBuild]::IsOSPlatform('WINDOWS'))">windows</_hostOS>

		<WasiSdkOsName></WasiSdkOsName>

		<WasiSdkOsName Condition="'$(_hostOS)' == 'windows'">x86_64-windows</WasiSdkOsName>
		<WasiSdkOsName Condition="'$(_hostOS)' == 'osx'">x86_64-macos</WasiSdkOsName>
		<WasiSdkOsName Condition="'$(_hostOS)' == 'linux'">x86_64-linux</WasiSdkOsName>

		<WasiSdkLocalPath>wasi-sdk-$(WasiSdkVersion).$(WasiSdkMinorVersion)-$(WasiSdkOsName)</WasiSdkLocalPath>
		<BinaryenLocalPath>binaryen-version_$(BinaryenVersion)</BinaryenLocalPath>
		<WasmLocalPath>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'wasm'))</WasmLocalPath>
		<ProvisionWasiSdkDir>$([MSBuild]::NormalizeDirectory('$(WasmLocalPath)', '$(WasiSdkLocalPath)'))</ProvisionWasiSdkDir>
		<ProvisionBinaryenDir>$([MSBuild]::NormalizeDirectory('$(WasmLocalPath)', '$(BinaryenLocalPath)'))</ProvisionBinaryenDir>
		<ShouldProvisionWasiSdk Condition="'$(WASI_SDK_PATH)' == '' and !Exists('$(ProvisionWasiSdkDir)')">true</ShouldProvisionWasiSdk>
		<ShouldProvisionBinaryen Condition="'$(BINARYEN_PATH)' == '' and !Exists('$(ProvisionBinaryenDir)')">true</ShouldProvisionBinaryen>
		<WASI_SDK_PATH Condition="'$(WASI_SDK_PATH)' == ''">$(ProvisionWasiSdkDir.Replace('\', '/'))</WASI_SDK_PATH>
		<BINARYEN_PATH Condition="'$(BINARYEN_PATH)' == ''">$(ProvisionBinaryenDir.Replace('\', '/'))</BINARYEN_PATH>
		<!-- semicolon is a msbuild property separator. It is also the path separator on windows.
         So, we need to escape it here, so the paths don't get split up when converting
         to string[] for passing to Exec task -->
		<_PathSeparator Condition="'$(OS)' == 'Windows_NT'">%3B</_PathSeparator>
		<_PathSeparator Condition="'$(OS)' != 'Windows_NT'">:</_PathSeparator>
	</PropertyGroup>

	<!-- Sets up wasi-sdk if you don't have the WASI_SDK_PATH env variable set -->
	<Target Name="ProvisionWasiSdk" Condition="'$(ShouldProvisionWasiSdk)' == 'true'" BeforeTargets="_InitializeWasiSdk">
		<PropertyGroup>
			<WasiSdkArchiveName>wasi-sdk-$(WasiSdkVersion).$(WasiSdkMinorVersion)-$(WasiSdkOsName).tar.gz</WasiSdkArchiveName>
			<WasiSdkUrl>https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-$(WasiSdkVersion)/$(WasiSdkArchiveName)</WasiSdkUrl>

			<WasiSdkArchivePath>$([MSBuild]::NormalizePath('$(WasmLocalPath)', '$(WasiSdkArchiveName)'))</WasiSdkArchivePath>

			<WASI_SDK_PATH>$(ProvisionWasiSdkDir)</WASI_SDK_PATH>
		</PropertyGroup>

		<Message Text="Provisioning Wasi SDK $(WasiSdkVersion).$(WasiSdkMinorVersion)..." Importance="High"/>

		<RemoveDir Directories="$(WASI_SDK_PATH)" />
		<MakeDir Directories="$(WasmLocalPath)" />

		<DownloadFile SourceUrl="$(WasiSdkUrl)" DestinationFolder="$(WasmLocalPath)" DestinationFileName="$(WasiSdkArchiveName)" Condition="!Exists('$(WasiSdkArchivePath)')" />

		<Exec Command="tar -xf &quot;$(WasiSdkArchivePath)&quot; -C &quot;$(WasmLocalPath.TrimEnd('\'))&quot;" />
	</Target>

	<!-- Sets up binaryen if you don't have the BINARYEN_PATH env variable set -->
	<Target Name="ProvisionBinaryen" Condition="'$(ShouldProvisionBinaryen)' == 'true'">
		<PropertyGroup>
			<_hostOS>linux</_hostOS>
			<_hostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_hostOS>
			<_hostOS Condition="$([MSBuild]::IsOSPlatform('WINDOWS'))">windows</_hostOS>

			<BinaryenOsName></BinaryenOsName>

			<BinaryenOsName Condition="'$(_hostOS)' == 'windows'">x86_64-windows</BinaryenOsName>
			<BinaryenOsName Condition="'$(_hostOS)' == 'osx'">x86_64-macos</BinaryenOsName>
			<BinaryenOsName Condition="'$(_hostOS)' == 'linux'">x86_64-linux</BinaryenOsName>

			<BinaryenArchiveName>binaryen-version_$(BinaryenVersion)-$(BinaryenOsName).tar.gz</BinaryenArchiveName>
			<BinaryenUrl>https://github.com/WebAssembly/binaryen/releases/download/version_$(BinaryenVersion)/$(BinaryenArchiveName)</BinaryenUrl>

			<BinaryenArchivePath>$([MSBuild]::NormalizePath('$(WasmLocalPath)', '$(BinaryenArchiveName)'))</BinaryenArchivePath>

			<BINARYEN_PATH>$(ProvisionBinaryenDir)</BINARYEN_PATH>
		</PropertyGroup>

		<Message Text="Provisioning Binaryen $(BinaryenVersion)..." Importance="High"/>

		<RemoveDir Directories="$(BINARYEN_PATH)" />
		<MakeDir Directories="$(WasmLocalPath)" />

		<DownloadFile SourceUrl="$(BinaryenUrl)" DestinationFolder="$(WasmLocalPath)" DestinationFileName="$(BinaryenArchiveName)" Condition="!Exists('$(BinaryenArchivePath)')" />

		<Exec Command="tar -xf &quot;$(BinaryenArchivePath)&quot; -C &quot;$(WasmLocalPath.TrimEnd('\'))&quot;" />
	</Target>

	<Import Project="$(MSBuildThisFileDirectory)WasiSdk.Defaults.props" />
	<Import Project="$(MSBuildThisFileDirectory)Binaryen.Defaults.props" />

	<Target Name="Screeps_LinkCoreModule" AfterTargets="LinkNativeLlvm" DependsOnTargets="ProvisionBinaryen">
		
		<PropertyGroup>
			<InputWasmFile>$(NativeOutputPath)\$(TargetName).wasm</InputWasmFile>
			<OutputWasmFile>$(NativeOutputPath)\$(TargetName)-linked.wasm</OutputWasmFile>
		</PropertyGroup>

		<Message Text="Linking wasm modules... $(WasmMainAssemblyFileName)" Importance="High"/>
		<Exec
			Command="&quot;$(WasmMerge)&quot; &quot;$(InputWasmFile)&quot; env @(WasmMergeModules, ' ') @(WasmMergeConfigurationFlags, ' ') -o &quot;$(OutputWasmFile)&quot;"
			WorkingDirectory="$(WasmAppDir)"
		/>
	</Target>

	<Target Name="Screeps_TrimWasmExports" AfterTargets="Screeps_LinkCoreModule" DependsOnTargets="ProvisionBinaryen">
		<PropertyGroup>
			<InputWasmFile>$(NativeOutputPath)\$(TargetName)-linked.wasm</InputWasmFile>
			<OutputWasmFile>$(NativeOutputPath)\$(TargetName)-trimmed.wasm</OutputWasmFile>
		</PropertyGroup>

		<Message Text="Trimming wasm exports... $(WasmMainAssemblyFileName)" Importance="High"/>
		<Exec
			Command="&quot;$(WasmMetadce)&quot; &quot;$(InputWasmFile)&quot; @(WasmMetadceConfigurationFlags, ' ') -o &quot;$(OutputWasmFile)&quot;"
			WorkingDirectory="$(WasmAppDir)"
		/>
	</Target>

	<Target Name="Screeps_OptimiseWasm" AfterTargets="Screeps_TrimWasmExports" DependsOnTargets="ProvisionBinaryen">
		<PropertyGroup>
			<InputWasmFile>$(NativeOutputPath)\$(TargetName)-trimmed.wasm</InputWasmFile>
			<OutputWasmFile>$(NativeOutputPath)\$(TargetName)-opt.wasm</OutputWasmFile>
		</PropertyGroup>

		<Message Text="Optimising wasm module... $(WasmMainAssemblyFileName)" Importance="High"/>
		<Exec
			Command="&quot;$(WasmOpt)&quot; &quot;$(InputWasmFile)&quot; @(WasmOptConfigurationFlags, ' ') -o &quot;$(OutputWasmFile)&quot;"
			WorkingDirectory="$(WasmAppDir)"
		/>
	</Target>

	<Target Name="Screeps_BuildScreepsBundle" AfterTargets="Publish" DependsOnTargets="Screeps_OptimiseWasm">
		<PropertyGroup>
			<InputWasmFile>$(NativeOutputPath)\$(TargetName)-opt.wasm</InputWasmFile>
		</PropertyGroup>

		<Message Text="Bundling for Screeps..." Importance="High"/>
		<BundlerBuildTask
			AppBundleDir="$(PublishDir)"
			WasmFileName="$(InputWasmFile)"
			Configuration="$(Configuration)"
			CompressWasm="$(ScreepsCompressWasm)"
			Encoding="$(ScreepsEncoding)"
			CustomInitExportNames="@(ScreepsCustomInitExportNames, ',')"
			WorldJsFiles="@(ScreepsWorldJsFiles, ',')"
			WorldStartup="@(ScreepsWorldStartup, ',')"
			WorldLoop="@(ScreepsWorldLoop, ',')"
			ArenaJsFiles="@(ScreepsArenaJsFiles, ',')"
			ArenaStartup="@(ScreepsArenaStartup, ',')"
			ArenaLoop="@(ScreepsArenaLoop, ',')"
		>
			<Output TaskParameter="BundleFilePaths" PropertyName="ScreepsBundleFilePaths" />
		</BundlerBuildTask>
	</Target>

</Project>
